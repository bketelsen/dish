# dsh web for dish: a systemd user unit of the unprivileged account that runs dsh (the account has linger on).
# deploy/update.sh copies it to ~/.config/systemd/user/dish-web.service and restarts it when it is stale; fleet no
# longer installs it. Nothing listens on the VM's own address: dsh binds 127.0.0.1:3080, and `tailscale serve` is what
# puts it on the tailnet.
[Unit]
Description=dsh web for dish
# The user manager has no network-online.target, so this does nothing. A start before the network is up fails, and
# Restart=on-failure below tries again.
After=network-online.target

[Service]
# ~/work is where agents start: it is the default directory of a new chat, the sandbox's fallback root, and where dsh
# reads a project .env. update.sh creates it. Without it the start fails with 200/CHDIR, which is wanted: it says the
# account was never set up, where a silent fallback to another directory would hand agents the wrong place. Keep it free
# of a .env file: dsh reads one from here, and whatever it names reaches the service and so every agent shell (dsh
# refuses only PATH, DSH_*, XDG_* and launch variables from it). dsh, below, finds its own files from its script's path,
# so the working directory does not matter to it.
WorkingDirectory=%h/work
# Written by fleet. It holds one line, DISH_TRUSTED_HOST=dish.<tailnet>.ts.net, which ExecStart below reads, and nothing
# else. The install's inputs (the config store's remote and the git identity) live in install.env, which this unit must
# never load: dsh passes its environment on to every agent shell, so anything loaded here reaches agents. The file is
# required, and both ways it can go wrong fail closed. With the file missing the unit does not start. With the variable
# missing from it, systemd passes one empty argument, dsh refuses to load (the trustedHosts entry "" is not a bare
# host[:port] authority), and the unit restarts every 5 seconds until fleet fixes the file.
EnvironmentFile=%h/.config/dish/deploy.env

# Where Node and pnpm are found, which is a contract with fleet's dish_guest role: it makes /opt/dish/node a symlink to
# the pinned Node install (24.21.0) and puts pnpm (11.25.0) in that Node's bin. Fleet no longer checks this line;
# update.sh reads it. install.sh, and update.sh's node and pnpm version checks, run with the target's copy of this line,
# read from git before the checkout moves, so an update installs with the tools of the service it starts. update.sh's
# own commands (git, curl, systemctl) run with this line as checked out when the update starts. Agents' commands
# inherit this PATH too (dsh keeps PATH and drops names that look like secrets), so it also says what a shell command
# can run. ExecStart below runs that Node by its full path, /opt/dish/node/bin/node.
#
# A second contract with fleet: this unit sets none of HOME, XDG_DATA_HOME or PNPM_HOME, and pnpm works its store out
# from them. install.sh pins the store that `pnpm store path` gives under its own environment into the profile, and
# dsh's plugin manager, running here, works it out again from this one. They must be the same store (pnpm refuses a
# profile recorded with another), so those three variables have to be the same for install.sh and for this unit.
# update.sh gives install.sh the account's passwd HOME, the one the user manager gives this unit, and neither
# XDG_DATA_HOME nor PNPM_HOME; fleet must not set any of them for just one of the two.
#
# No DISH_ENV either. Root package scripts go through the launcher (scripts/env.ts), which defaults to dev and sets the
# dev environment; the service is prod because it never goes through the launcher, so it gets the account's own
# directories. Setting DISH_ENV=prod here would reach every agent shell, since dsh passes its environment on.
Environment=PATH=/opt/dish/node/bin:/usr/local/bin:/usr/bin:/bin

# The checkout's dsh, not `pnpm dsh`: root scripts are wrapped by the launcher, and the launcher would start the VM on an
# empty dev store. It is dsh's own script, run by the Node of the PATH line, and not its node_modules/.bin/dsh shim. The
# shim exports a NODE_PATH that names the checkout's node_modules/.pnpm/node_modules, which dsh would pass on to every
# agent shell, where every CommonJS program falls back to it: a module an agent planted there would load in a later
# command, approved escalations outside the sandbox included. The shim also runs a node_modules/.bin/node in place of
# Node when there is one. The script's path is the bin of the checkout's @deepseek-ai/dsh, which deploy/test checks.
# --trusted-host takes any number of values, so it must stay last. DISH_TRUSTED_HOST is a bare host name, no scheme.
ExecStart=/opt/dish/node/bin/node %h/dish/node_modules/@deepseek-ai/dsh/lib/bin.js web --host 127.0.0.1 --port 3080 --no-open --trusted-host ${DISH_TRUSTED_HOST}
Restart=on-failure
RestartSec=5

# No sandboxing options on purpose. Every command an agent runs is a child of this service, and dsh confines those
# itself, with bubblewrap (user, PID and mount namespaces) or else Landlock, inside a transient user scope. Options that
# restrict the whole service are inherited by those children, and would break them, or V8:
#   RestrictNamespaces=, PrivateUsers=  bubblewrap could not make its namespaces, so dsh would refuse every shell
#                                       command.
#   SystemCallFilter=                   it could block the calls bubblewrap and Landlock make.
#   MemoryDenyWriteExecute=             V8's JIT needs memory that is writable and executable.
#   ProtectSystem=, ProtectHome=        they remount the file system under dsh's own sandbox, which binds / and the
#                                       workspace itself.
#   NoNewPrivileges=                    it would also stop sudo in the escalated commands an agent is allowed to run.
# That is reasoned from dsh's code, not tested (docs/research/2026-10-01-dsh-linux-host.md). If hardening is added
# later, run dsh's bubblewrap probe and a real agent command under it first.

[Install]
WantedBy=default.target
