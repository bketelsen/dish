#!/bin/sh
# git-credential-dish-push: the one-shot credential helper of dish's own push (dish-workspaces' pushBranch).
#
# Only dish's push names it, on the command line, after an empty entry that drops every other helper:
#   git -c credential.helper= -c "credential.helper=!/bin/sh '<this file>' '<web origin>'" push …
# git runs that through its shell and adds its action (get, store or erase), then writes the request on stdin:
# key=value lines, ending with a blank line or EOF.
#
# The write token is not in a file, an argument or the environment: dish writes it, one line, to git's fd 3 (a socket
# git and its children inherit) and closes its end. On `get` for <web origin> (`<protocol>://<host>`, exactly; a port
# is part of host) this reads that one line from fd 3 and answers:
#   username=x-access-token
#   password=<the line>
#   quit=true
# - Another origin, or nothing to read on fd 3 (closed, empty, or read already by an earlier get): quit=true alone, so
#   git asks no one else and never prompts. A second get never gets the token again.
# - store, erase or anything else, or no web origin: nothing, exit 0. git's credential is never read, so nothing keeps it.
# It never echoes its input, writes no file, and runs no external command on the token; it goes to git on stdout only.
# POSIX sh (shellcheck clean). git runs it through /bin/sh by its absolute path, so it needs no exec bit.

set -u
# Byte-wise comparisons, whatever the caller's locale.
LC_ALL=C
export LC_ALL

web=${1-}
action=${2-}

if [ "$action" != get ] || [ -z "$web" ]; then
  exit 0
fi

protocol=
host=
while IFS= read -r line || [ -n "$line" ]; do
  if [ -z "$line" ]; then
    break
  fi
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done

if [ "$protocol://$host" != "$web" ]; then
  echo quit=true
  exit 0
fi

token=
{ IFS= read -r token <&3; } 2>/dev/null || :
if [ -z "$token" ]; then
  echo quit=true
  exit 0
fi
# printf must stay a shell builtin: an external printf (or `env printf`) would put the token in /proc/<pid>/cmdline.
printf 'username=x-access-token\npassword=%s\nquit=true\n' "$token"
