#!/bin/sh
# git-credential-dish: the git credential helper of the clones dish-workspaces makes.
#
# Each clone's config names it, after an empty entry that drops any other helper for that origin, with useHttpPath:
#   credential.<web origin>.helper = !/bin/sh '<this file>' '<tokens dir>' '<web origin>'
# git runs that through its shell and adds its action (get, store or erase), then writes the request on stdin:
# key=value lines, ending with a blank line or EOF.
#
# It answers `get` for <web origin> only (`<protocol>://<host>`, exactly; a port is part of host) with the read token
# dish-workspaces keeps in <tokens dir>/<owner>, the owner being the URL path's first part, lower-cased:
#   username=x-access-token
#   password=<the file's first line>
#   quit=true
# - An owner that isn't a GitHub login (empty, or anything but A-Z, a-z, 0-9 and -), or one without a readable,
#   non-empty token file: quit=true alone, so git asks no one else and never prompts.
# - Another origin: nothing at all, exit 0.
# - store, erase or anything else: nothing, exit 0. git's credential is never read, so nothing keeps it.
# It never echoes its input, writes no file, and calls nothing on the network; the token goes to git on stdout only.
# POSIX sh (shellcheck clean). git runs it through /bin/sh by its absolute path, so it needs no exec bit.

set -u
# Byte-wise character ranges and tr, whatever the caller's locale.
LC_ALL=C
export LC_ALL

tokens=${1-}
web=${2-}
action=${3-}

if [ "$action" != get ] || [ -z "$tokens" ] || [ -z "$web" ]; then
  exit 0
fi

protocol=
host=
path=
while IFS= read -r line || [ -n "$line" ]; do
  if [ -z "$line" ]; then
    break
  fi
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
  esac
done

if [ "$protocol://$host" != "$web" ]; then
  exit 0
fi

owner=${path%%/*}
case $owner in
  '' | *[!A-Za-z0-9-]*)
    echo quit=true
    exit 0
    ;;
esac
owner=$(printf '%s\n' "$owner" | tr '[:upper:]' '[:lower:]')

file=$tokens/$owner
token=
if [ -f "$file" ] && [ -r "$file" ]; then
  { IFS= read -r token <"$file"; } 2>/dev/null || :
fi
if [ -z "$token" ]; then
  echo quit=true
  exit 0
fi
# printf must stay a shell builtin: an external printf (or `env printf`) would put the token in /proc/<pid>/cmdline.
printf 'username=x-access-token\npassword=%s\nquit=true\n' "$token"
